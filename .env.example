# ==============================================================================
# NEXUSMAP - Production & Deployment Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env: `cp .env.example .env`
# 2. Generate secure production secrets using: `openssl rand -hex 32`
# 3. NEVER commit your actual `.env` file to Git or version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL with PostGIS Spatial Extension
# ------------------------------------------------------------------------------
POSTGRES_DB=nexusmap
POSTGRES_USER=nexus_user
# Generate a strong password: openssl rand -base64 24
POSTGRES_PASSWORD=replace_with_strong_db_password_here

# ------------------------------------------------------------------------------
# 2. Redis 7 Cache & Spatial Pub/Sub
# ------------------------------------------------------------------------------
# Generate a strong Redis auth secret: openssl rand -hex 24
REDIS_PASSWORD=replace_with_strong_redis_password_here

# ------------------------------------------------------------------------------
# 3. Spring Boot Backend & JWT Cryptography
# ------------------------------------------------------------------------------
# Profile: use 'prod' for production, 'dev' for local testing
SPRING_PROFILES_ACTIVE=prod

# JWT HMAC-SHA256 Secret (MUST be >= 256 bits / 32 bytes hex encoded)
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_64_character_hex_hmac_secret_here

# Token Lifespan (default: 86400000ms = 24 hours)
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated HTTPS origins in production)
CORS_ALLOWED_ORIGINS=https://nexusmap.yourdomain.com,https://map.nexusmap.yourdomain.com

# Cookie Security (set true when terminating TLS/HTTPS in production)
NEXUSMAP_COOKIES_SECURE=true

# Demo Account Auto-Seeding (Set false in production)
NEXUSMAP_SEED_DEMO_ACCOUNTS=false

# ------------------------------------------------------------------------------
# 4. Nginx Reverse Proxy & Port Bindings
# ------------------------------------------------------------------------------
HTTP_PORT=80
HTTPS_PORT=443

# ------------------------------------------------------------------------------
# 5. Map & Cartography Settings (OpenStreetMap / Custom Vector Tiles)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_MAP_DEFAULT_LAT=37.7749
NEXT_PUBLIC_MAP_DEFAULT_LNG=-122.4194
NEXT_PUBLIC_MAP_DEFAULT_ZOOM=14

# Production Tile Provider (Default: Standard OpenStreetMap raster tiles)
# For commercial/high-traffic deployments: Mapbox, Stadia Maps, or self-hosted TileServer-GL
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
